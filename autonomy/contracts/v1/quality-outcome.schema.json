{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dzikle/Ai-factory/blob/main/autonomy/contracts/v1/quality-outcome.schema.json",
  "title": "Deterministic validation or independent review/QA evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "task_id", "run_id", "subject_run_id", "actor_agent_id", "subject_agent_id", "verdict", "evidence_refs", "recorded_at"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["validation", "review", "qa"]},
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "subject_run_id": {"type": "string", "minLength": 1},
    "actor_agent_id": {"type": "string", "minLength": 1},
    "subject_agent_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["passed", "failed", "accepted", "changes_requested", "blocked"]},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recorded_at": {"type": "string", "format": "date-time"},
    "findings": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["severity", "summary", "evidence_ref"],
      "properties": {
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    }}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "validation"}}}, "then": {"properties": {"verdict": {"enum": ["passed", "failed", "blocked"]}}}},
    {"if": {"properties": {"kind": {"enum": ["review", "qa"]}}}, "then": {"properties": {"verdict": {"enum": ["accepted", "changes_requested", "blocked"]}}}}
  ]
}
