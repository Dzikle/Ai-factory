{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dzikle/Ai-factory/blob/main/autonomy/contracts/v1/memory-record.schema.json",
  "title": "MemPalace experiential record metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "memory_id", "project_id", "scope", "kind", "status", "content_ref", "content_sha256", "observed_at", "review_after", "retention_until", "supersedes", "source_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "memory_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "scope": {"enum": ["global", "project", "agent"]},
    "specialist_role": {"type": "string", "minLength": 1},
    "kind": {"enum": ["incident", "lesson", "decision_history", "qa_pattern", "rejected_approach"]},
    "status": {"enum": ["active", "superseded", "expired"]},
    "content_ref": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "review_after": {"type": "string", "format": "date-time"},
    "retention_until": {"type": "string", "format": "date-time"},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "superseded_by": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["source_system", "source_id", "source_version"],
        "properties": {
          "source_system": {"enum": ["git", "paperclip", "artifact", "runtime"]},
          "source_id": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "superseded"}}}, "then": {"required": ["superseded_by"]}},
    {"if": {"properties": {"scope": {"const": "agent"}}}, "then": {"required": ["specialist_role"]}}
  ]
}
