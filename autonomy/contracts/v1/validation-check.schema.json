{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dzikle/Ai-factory/blob/main/autonomy/contracts/v1/validation-check.schema.json",
  "title": "Deterministic workspace validation definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "check_id", "task_class", "argv", "working_directory", "timeout_seconds", "expected_exit_code"],
  "properties": {
    "schema_version": {"const": 1},
    "check_id": {"type": "string", "minLength": 1},
    "task_class": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "working_directory": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._/-]+$", "not": {"pattern": "(^/|^[A-Za-z]:|(^|/)\\.\\.(/|$))"}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "expected_exit_code": {"type": "integer", "minimum": 0, "maximum": 255}
  }
}
