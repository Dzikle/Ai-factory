{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dzikle/Ai-factory/blob/main/autonomy/contracts/v1/context-query-plan.schema.json",
  "title": "Bounded context query plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "project_id", "role", "total_budget", "queries"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "total_budget": {"$ref": "#/$defs/total_budget"},
    "queries": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["domain", "purpose", "text", "max_hits", "max_tokens", "max_bytes", "filters"],
        "properties": {
          "domain": {"enum": ["docs", "decisions", "memory", "tasks", "capabilities", "code_metadata"]},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 120},
          "text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "max_hits": {"type": "integer", "minimum": 1, "maximum": 50},
          "max_tokens": {"type": "integer", "minimum": 1, "maximum": 8192},
          "max_bytes": {"type": "integer", "minimum": 1, "maximum": 32768},
          "filters": {
            "type": "object", "additionalProperties": false,
            "required": ["project_id", "statuses"],
            "properties": {
              "project_id": {"type": "string", "minLength": 1},
              "statuses": {"type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"enum": ["active", "canonical", "historical", "superseded"]}},
              "source_revision": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "total_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_tokens", "max_bytes"],
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 32768},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 131072}
      }
    }
  }
}
