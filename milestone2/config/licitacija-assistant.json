{
  "name": "Licitacija Assistant",
  "role": "general",
  "title": "Read-only repository assistant",
  "capabilities": "Answer questions about the assigned Licitacija Git snapshot. No coding, publishing, deployment or access to live-service credentials.",
  "adapterType": "opencode_local",
  "adapterConfig": {
    "cwd": "/paperclip/licita-help-source",
    "model": "opencode/muse-spark-1.3-contributor-free",
    "timeoutSec": 240,
    "dangerouslySkipPermissions": false,
    "extraArgs": ["--agent", "licitacija-assistant", "--pure"],
    "env": {
      "XDG_DATA_HOME": "/paperclip/instances/default/workspaces/74519fa4-15c6-437c-9694-5d2579b76356/.local/share",
      "GIT_CONFIG_COUNT": "1",
      "GIT_CONFIG_KEY_0": "safe.directory",
      "GIT_CONFIG_VALUE_0": "/paperclip/licita-help-source"
    }
  },
  "runtimeConfig": {"heartbeat": {"enabled": false, "maxConcurrentRuns": 1}},
  "budgetMonthlyCents": 500,
  "permissions": {"canCreateAgents": false, "canCreateSkills": false},
  "metadata": {"setupKey": "licitacija-read-only-v1"},
  "nativeConfig": {
    "$schema": "https://opencode.ai/config.json",
    "small_model": "opencode/muse-spark-1.3-contributor-free",
    "permission": {
      "*": "deny",
      "read": {"*": "allow", "*.env": "deny", "*.env.*": "deny", "**/.git/**": "deny", "**/auth.json": "deny", "**/.milestone0/**": "deny"},
      "glob": "allow",
      "grep": "allow",
      "bash": {"*": "deny", "git rev-parse HEAD": "allow", "git status --porcelain": "allow", "python3 /paperclip/assistant-reply.py --answer *": "allow"},
      "external_directory": "deny"
    },
    "agent": {
      "licitacija-assistant": {
        "description": "Read-only Licitacija repository questions",
        "mode": "primary",
        "steps": 10,
        "permission": {
          "*": "deny",
          "read": {"*": "allow", "*.env": "deny", "*.env.*": "deny", "**/.git/**": "deny", "**/auth.json": "deny", "**/.milestone0/**": "deny"},
          "glob": "allow",
          "grep": "allow",
          "bash": {"*": "deny", "git rev-parse HEAD": "allow", "git status --porcelain": "allow", "python3 /paperclip/assistant-reply.py --answer *": "allow"},
          "external_directory": "deny"
        }
      }
    }
  }
}
