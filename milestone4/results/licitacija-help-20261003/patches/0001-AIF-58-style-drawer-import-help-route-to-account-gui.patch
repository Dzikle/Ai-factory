+            } catch (err) {
+                return null;
+            }
+        }
+
+        var requestedUrlTour = getRequestedUrlTour();
+        if (requestedUrlTour) {
+            window.setTimeout(function () {
+                openTour(requestedUrlTour);
+            }, 60);
