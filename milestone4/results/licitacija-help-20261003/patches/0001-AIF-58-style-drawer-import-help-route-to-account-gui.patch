         });
 
+        // AIF-58: honor a bounded tour request from the URL (the mobile drawer
+        // help routes here with ?tour=single-import). Only known tour names
+        // open; anything else is ignored. Ordinary clicks are unaffected.
+        var KNOWN_URL_TOURS = { 'single-import': 'single-import' };
+
+        function getRequestedUrlTour() {
+            try {
+                var params = new URLSearchParams(window.location.search);
+                var requested = params.get('tour');
+                if (!requested) return null;
