+
+/* =======================================================
+   AIF-58: DRAWER IMPORT-HELP ACTION
+   The listings help trigger is copied from the account page
+   without page-only account.css. Style it here like the
+   account guide trigger (pill, touch-sized, full-width) and
+   stack the listings header so nothing clips at 360-412px.
+   ======================================================= */
+
+#drawerDynamicContent .listings-section-header {
+    display: flex;
+    flex-direction: column;
+    align-items: stretch;
+    gap: 10px;
+    margin-bottom: 12px;
+}
+
+#drawerDynamicContent .listings-section-actions {
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+    width: 100%;
+    max-width: 100%;
+}
+
+#drawerDynamicContent .account-tour-trigger,
+#drawerDynamicContent .drawer-import-help {
+    box-sizing: border-box;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 8px;
+    width: 100%;
+    max-width: 100%;
+    min-height: 44px;
+    padding: 10px 14px;
+    border-radius: 999px;
+    border: 1.5px solid color-mix(in srgb, var(--accent-color), transparent 72%);
+    background: #fff;
+    color: var(--heading-color);
+    font-size: 13px;
+    font-weight: 700;
+    line-height: 1.3;
+    text-align: center;
+    overflow-wrap: anywhere;
+    cursor: pointer;
+    transition: border-color 0.16s ease, background 0.16s ease, color 0.16s ease;
+}
+
+#drawerDynamicContent .account-tour-trigger i,
+#drawerDynamicContent .drawer-import-help i {
+    color: var(--accent-color);
+    font-size: 15px;
+    flex-shrink: 0;
+}
+
+#drawerDynamicContent .account-tour-trigger:hover,
+#drawerDynamicContent .drawer-import-help:hover {
+    border-color: var(--accent-color);
+    background: color-mix(in srgb, var(--accent-color), transparent 95%);
+    color: var(--accent-color);
+}
+
+#drawerDynamicContent .account-tour-trigger:focus-visible,
+#drawerDynamicContent .drawer-import-help:focus-visible {
+    outline: none;
+    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-color), transparent 84%);
+}
+
+#drawerDynamicContent .listing-add-btn {
+    width: 100%;
+    justify-content: center;
+    max-width: 100%;
+}
diff --git a/src/main/webapp/WEB-INF/views/homespace/assets/js/account-import-tour.js b/src/main/webapp/WEB-INF/views/homespace/assets/js/account-import-tour.js
